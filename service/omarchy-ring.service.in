[Unit]
Description=omarchy-ring: Ring camera events for the Omarchy bar
After=graphical-session.target network-online.target
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
# install.sh fills in @NODE@ and @NODE_ROOT@.
ExecStart=@NODE@ %h/.local/share/omarchy-ring/omarchy-ring.mjs
WorkingDirectory=%h/.local/share/omarchy-ring
Restart=always
RestartSec=10
MemoryMax=400M
Nice=10

# Sandbox: an empty home except the service's own code, config and state.
ProtectHome=tmpfs
BindReadOnlyPaths=%h/.local/share/omarchy-ring @NODE_ROOT@
BindPaths=%h/.config/omarchy-ring %h/.local/state/omarchy-ring
# Session bus (notifications) and systemd's socket (systemd-run).
BindPaths=%t/bus %t/systemd/private
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077

[Install]
WantedBy=graphical-session.target
